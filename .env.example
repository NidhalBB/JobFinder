# Netlify environment variables, never browser code. Do not commit populated copies.
# Replace the placeholder site name with the permanent Netlify HTTPS address.
PUBLIC_ORIGIN=https://your-nextstep-site.netlify.app
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are also supported.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=

# Optional daily notifications: set all five or leave all five unset.
# Configure Supabase Auth SMTP separately in its dashboard for signup/recovery.
SMTP_HOST=
# SMTP_PORT must be 465 or 587 when enabled.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=
