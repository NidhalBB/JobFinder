# Copy outside the application directory, to /etc/nextstep.env on the Linux host.
# Replace the public origin; do not include a path or a trailing slash.
PUBLIC_ORIGIN=https://jobs.example.com

# Leave all five SMTP values empty to disable daily email notifications.
# Configure only on the server. Never put real secrets in Git or a chat message.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM=
